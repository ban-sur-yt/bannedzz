--// Animated open / close
local panelOpen = false
local animating = false

-- Set by the mobile UI block below (nil on PC)
local mobileToggleBtn = nil

local function fadeMobileToggle(visible)
	if not mobileToggleBtn then return end
	local mbg = mobileToggleBtn:FindFirstChild("Bg")
	if visible then
		mobileToggleBtn.Visible = true
		TweenService:Create(mobileToggleBtn, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextTransparency = 0,
		}):Play()
		if mbg then
			TweenService:Create(mbg, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 }):Play()
		end
	else
		TweenService:Create(mobileToggleBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
		}):Play()
		if mbg then
			TweenService:Create(mbg, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 }):Play()
		end
		task.delay(0.3, function()
			if not panelOpen then mobileToggleBtn.Visible = false end
		end)
	end
end

local function togglePanel()
	if animating then return end
	animating = true
	playSound()
	if panelOpen then
		panelOpen = false
		fadeMobileToggle(true)
		-- Fade out + shrink
		TweenService:Create(uiScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = targetScale * 0.9 }):Play()
		local t = TweenService:Create(root, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
		t:Play()
		t.Completed:Connect(function()
			root.Visible = false
			animating = false
		end)
	else
		panelOpen = true
		fadeMobileToggle(false)
		root.Visible = true
		uiScale.Scale = targetScale * 0.9
		-- Fade in + pop open
		local t = TweenService:Create(root, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 })
		t:Play()
		TweenService:Create(uiScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = targetScale }):Play()
		t.Completed:Connect(function()
			animating = false
		end)
	end
end

