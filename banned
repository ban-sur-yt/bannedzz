local avatarModel = nil

local function buildAvatar()
	local char = LocalPlayer.Character
	if not char then return end
	-- Clear any old avatar (keep the camera, glow, and floor)
	for _, c in viewport:GetChildren() do
		if c ~= vcam and c ~= glowPart and c ~= floor then c:Destroy() end
	end
	local oldArchivable = char.Archivable
	char.Archivable = true
	local clone = char:Clone()
	char.Archivable = oldArchivable
	-- Remove scripts so nothing runs inside the viewport
	for _, d in clone:GetDescendants() do
		if d:IsA("BaseScript") then d:Destroy() end
	end
	clone:PivotTo(CFrame.new(0, 3, 0))
	clone.Parent = viewport
	avatarModel = clone
end

