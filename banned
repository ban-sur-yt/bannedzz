--// Mobile-friendly auto-fit scaling
local uiScale = Instance.new("UIScale")
uiScale.Name = "Scale"
uiScale.Parent = main

local targetScale = 1
local function fitPanel()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	-- On mobile, reserve the top ~90px for the toggle button and allow
	-- shrinking further so the panel never covers the screen edges
	local reserved = isMobile and 90 or 0
	local minScale = isMobile and 0.38 or 0.5
	targetScale = math.clamp(math.min(vp.X / 660, (vp.Y - reserved) / 460), minScale, 1)
	uiScale.Scale = targetScale
	-- Shift the panel down slightly on mobile so the top toggle button area stays clear
	main.Position = UDim2.new(0.5, 0, 0.5, isMobile and 12 or 0)
end
fitPanel()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	fitPanel()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(fitPanel)
	end
end)
local currentCam = workspace.CurrentCamera
if currentCam then
	currentCam:GetPropertyChangedSignal("ViewportSize"):Connect(fitPanel)
end

