-- Screen shake + warning shown when noclip is blocked by an active autofarm
local function shakeScreen()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local base = cam.CFrame
	local t0 = os.clock()
	local dur = 0.4
	while os.clock() - t0 < dur do
		local a = 3 * (1 - (os.clock() - t0) / dur)
		cam.CFrame = base * CFrame.Angles((math.random() - 0.5) * a / 20, (math.random() - 0.5) * a / 20, 0)
		RunService.RenderStepped:Wait()
	end
	cam.CFrame = base
end

