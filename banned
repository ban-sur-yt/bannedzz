local function makeToggle(parent, text, order, callback, defaultOn)
	local card = makeCard(parent, order, 46)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -80, 1, 0)
	label.Position = UDim2.new(0, 14, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(235, 235, 240)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 16
	label.Parent = card

	local pill = Instance.new("TextButton")
	pill.Size = UDim2.fromOffset(46, 22)
	pill.Position = UDim2.new(1, -14, 0.5, -11)
	pill.AnchorPoint = Vector2.new(1, 0)
	pill.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
	pill.Text = ""
	pill.AutoButtonColor = false
	pill.Parent = card
	corner(pill, 999)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(18, 18)
	knob.Position = UDim2.new(0, 2, 0.5, -9)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Parent = pill
	corner(knob, 999)

	local on = defaultOn or false
	if on then
		pill.BackgroundColor3 = ACCENT
		knob.Position = UDim2.new(1, -20, 0.5, -9)
	end
	pill.MouseButton1Click:Connect(function()
		on = not on
		playSound()
		local requested = on
		TweenService:Create(pill, TweenInfo.new(0.2), {
			BackgroundColor3 = on and ACCENT or Color3.fromRGB(60, 60, 68),
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
		}):Play()
		callback(on)
		if on == requested and showNotification then
			local shortName = text:match("^([^%(]-)%s*%(") or text
			showNotification(shortName .. (on and " enabled" or " disabled"), on and "✅" or "⛔")
		end
	end)

	-- Programmatically set the toggle state without firing the callback
	local function setOn(v)
		if on == v then return end
		on = v
		TweenService:Create(pill, TweenInfo.new(0.2), {
			BackgroundColor3 = on and ACCENT or Color3.fromRGB(60, 60, 68),
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
		}):Play()
	end

	return pill, setOn
end

