--// Tab system
local tabs = {}

local currentTab = nil

local function selectTab(name)
	local changed = currentTab ~= name
	currentTab = name
	for n, data in pairs(tabs) do
		local selected = (n == name)
		data.frame.Visible = selected
		data.indicator.Visible = selected
		TweenService:Create(data.button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = selected and ACCENT or Color3.fromRGB(34, 34, 40),
			TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(170, 170, 182),
		}):Play()
		if selected and changed then
			data.frame.Position = UDim2.fromOffset(0, 10)
			TweenService:Create(data.frame, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(0, 0) }):Play()
		end
	end
end


local function makeTab(name, order)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.BackgroundColor3 = Color3.fromRGB(34, 34, 40)
	btn.TextColor3 = Color3.fromRGB(200, 200, 210)
	btn.Font = Enum.Font.FredokaOne
	btn.TextSize = 15
	btn.Text = name
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	btn.Parent = tabHolder
	corner(btn, 10)
	local btnPad = Instance.new("UIPadding")
	btnPad.PaddingLeft = UDim.new(0, 20)
	btnPad.Parent = btn
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.MouseButton1Click:Connect(function()
		playSound()
		-- Click pop animation
		TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, -6, 0, 32) }):Play()
		task.delay(0.08, function()
			TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 36) }):Play()
		end)
		selectTab(name)
	end)

	local frame = Instance.new("Frame")
	frame.Name = name .. "Content"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = content

	local indicator = Instance.new("Frame")
	indicator.Name = "Indicator"
	indicator.Size = UDim2.new(0, 3, 0.5, 0)
	indicator.Position = UDim2.new(0, -14, 0.25, 0)
	indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	indicator.BorderSizePixel = 0
	indicator.Visible = false
	indicator.Parent = btn
	corner(indicator, 2)

	btn.MouseEnter:Connect(function()
		if currentTab ~= name then
			TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(48, 48, 56) }):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if currentTab ~= name then
			TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(34, 34, 40) }):Play()
		end
	end)

	tabs[name] = { button = btn, frame = frame, indicator = indicator }
	return frame
end

