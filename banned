-- Autofarm: teleport to every candy on the map, one after another
task.spawn(function()
	while true do
		if state.autofarm then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				-- Find the nearest candy on the map (any part with "candy" in its name)
				local nearest, nearestDist = nil, math.huge
				for _, d in workspace:GetDescendants() do
					if d:IsA("BasePart") and string.find(string.lower(d.Name), "candy", 1, true) then
						local dist = (d.Position - hrp.Position).Magnitude
						if dist < nearestDist then
							nearest, nearestDist = d, dist
					end
					end
				end
				if nearest then
					farmStatusLabel.Text = "Status: Teleporting to candy..."
					-- Teleport right on top of the candy
					hrp.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 3, 0))
					-- Give the candy a moment to be collected before moving on
					task.wait(0.5)
				else
					farmStatusLabel.Text = "Status: No candy found, searching..."
					task.wait(0.5)
				end
			else
				task.wait(0.5)
			end
		else
			task.wait(0.25)
		end
	end
end)

-- Autofarm Coins: smoothly glide to the nearest coin, collect it,
-- wait 0.2 seconds, then glide to the next one. Coins that don't disappear
-- after collection are skipped briefly so the farm never gets stuck.
task.spawn(function()
	-- Coins to temporarily ignore (coin -> ignore-until time)
	local ignored = {}
	while true do
		if state.coinfarm then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				-- Find the nearest coin: CoinContainer first, then any part with "coin" in its name
				local nearest, nearestDist = nil, math.huge
				local container = workspace:FindFirstChild("CoinContainer")
				if container then
					for _, coin in container:GetChildren() do
					if coin:IsA("BasePart") and (ignored[coin] or 0) < os.clock() then
						local dist = (coin.Position - hrp.Position).Magnitude
						if dist < nearestDist then
							nearest, nearestDist = coin, dist
						end
					end
				end
				end
				if not nearest then
					for _, d in workspace:GetDescendants() do
						if d:IsA("BasePart") and string.find(string.lower(d.Name), "coin", 1, true) and (ignored[d] or 0) < os.clock() then
						local dist = (d.Position - hrp.Position).Magnitude
							if dist < nearestDist then
							nearest, nearestDist = d, dist
						end
					end
					end
				end
				if nearest then
					farmStatusLabel.Text = "Status: Gliding to coin..."
					-- Float while gliding: anchor the root part so gravity
					-- can't pull us off the map when there's no floor below
					hrp.Anchored = true
					-- Glide smoothly toward the coin, frame by frame
					while state.coinfarm and nearest.Parent do
						local c = LocalPlayer.Character
						local h = c and c:FindFirstChild("HumanoidRootPart")
						if not h then break end
						local delta = nearest.Position - h.Position
						local dist = delta.Magnitude
						if dist < 3 then
							-- Arrived: sit on the coin so it gets collected
							h.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 1, 0))
							break
						end
						-- Move toward the coin at a smooth walking-like speed
						local speed = 24
						local dt = RunService.Heartbeat:Wait()
						local step = math.min(dist, speed * dt)
						h.CFrame = h.CFrame + delta.Unit * step
					end
					-- Stop floating: give control back to normal physics
					if hrp and hrp.Parent then
						hrp.Anchored = false
					end
					-- Give the coin 0.2 seconds to be collected
					task.wait(0.2)
					if nearest.Parent then
						-- Coin didn't disappear: ignore it for 3 seconds so we move on
					ignored[nearest] = os.clock() + 3
					farmStatusLabel.Text = "Status: Moving to next coin..."
					end
				else
					farmStatusLabel.Text = "Status: No coins found, searching..."
					task.wait(0.1)
				end
			else
				task.wait(0.25)
			end
		else
			task.wait(0.25)
		end
	end
end)

-- Aimbot: lock camera onto nearest player
local function getNearestTarget()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local nearest, nearestDist = nil, math.huge
	for _, plr in Players:GetPlayers() do
		if plr ~= LocalPlayer then
			local tChar = plr.Character
			local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
			if tHrp and tHum and tHum.Health > 0 then
				local dist = (tHrp.Position - hrp.Position).Magnitude
				if dist < nearestDist then
				nearest, nearestDist = tHrp, dist
				end
			end
		end
	end
	return nearest
end

